@baseUrl = http://localhost:3000/v1/api
@readKey = replace-with-your-read-key
@writeKey = replace-with-your-write-key

GET {{baseUrl}}/health/ready

### List customers
GET {{baseUrl}}/customers?limit=20&offset=0
x-api-key: {{readKey}}

### Create a product (prices in minor units)
POST {{baseUrl}}/products
x-api-key: {{writeKey}}
Content-Type: application/json

{"productName":"Example","productvendor":"Vendor","productDescription":"Example product","quantityInStock":10,"buyPrice":100,"msrp":150}

### Create an order after replacing the IDs
POST {{baseUrl}}/orders
x-api-key: {{writeKey}}
Idempotency-Key: example-order-001
Content-Type: application/json

{"customerId":"00000000-0000-4000-8000-000000000001","orderItems":[{"productId":"00000000-0000-4000-8000-000000000002","quantity":1}]}
